# Credentials and secrets
.env

# Garth session tokens — written by the downloader via GARTH_SESSION_PATH.
# The directory is .garth (not .garmin); getting this wrong commits live
# OAuth tokens to the repository.
.garth/
.garmin/

# Database
*.db
*.db-shm
*.db-wal

# Exported activity files — personal training data, never commit
exports/
*.fit
*.tcx
*.gpx
*.zip

# Run logs — they quote file paths and account data
*.log

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp

# Claude Code local settings
.claude/

# =============================================================================
# GARMIN CONNECT CREDENTIALS
# =============================================================================
# Your normal Garmin Connect login.

GARMIN_EMAIL=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password

# Where garth stores the OAuth session tokens after the first successful login.
# Keep this directory out of version control — it holds live credentials.
GARTH_SESSION_PATH=.garth

# =============================================================================
# SYNC SETTINGS
# =============================================================================

# Path to the SQLite database the downloader writes.
DB_PATH=./garmin_activities.db

# Number of activities to request per run.
GARMIN_LIMIT=100

# Earliest date to sync (YYYY-MM-DD). Defaults to 2 years back if unset.
# The --days flag overrides this.
GARMIN_START_DATE=2020-01-01

# =============================================================================
# MCP SERVER HTTP TRANSPORT
# =============================================================================

# "http" for remote MCP clients, "stdio" for local Claude Desktop.
GARMIN_MCP_TRANSPORT=http

# Required when GARMIN_MCP_TRANSPORT=http.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GARMIN_MCP_AUTH_TOKEN=

# HTTP bind address and port.
GARMIN_MCP_HTTP_HOST=0.0.0.0
GARMIN_MCP_HTTP_PORT=8080

# Database path used by the MCP server (defaults to ./garmin_activities.db).
GARMIN_DB_PATH=./garmin_activities.db
